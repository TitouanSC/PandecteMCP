# Configuration du serveur MCP PandecteMCP — exemple à valeurs FACTICES.
#
# Pour un essai local : cp .env.example .env, puis remplacer les valeurs.
# Le fichier .env est ignoré par Git. Ne jamais commiter de vraie valeur.
# En production (Render), ces variables se saisissent dans le tableau de bord
# de l'hébergeur ; voir docs/deployment.md.

# -- Mode d'exécution ------------------------------------------------------------
# development | test | production (production impose tous les contrôles).
MCP_ENV=development
# disabled : usage local, identifiants PISTE ci-dessous ;
# piste : serveur hébergé, chaque utilisateur se connecte avec SES identifiants.
MCP_AUTH_MODE=piste
# URL publique sans /mcp. Hors production, http://localhost:PORT est accepté.
MCP_PUBLIC_URL=http://localhost:8765
MCP_PORT=8765

# -- Clé de scellement des jetons (mode piste) -------------------------------------
# 32 octets aléatoires en base64url. Pour en tirer une :
#   python -c "from mcp_server.sealed import new_key_text; print(new_key_text())"
# Hors production, une clé aléatoire par processus est tirée si absente.
# PANDECTE_SEAL_KEY=cle-factice-a-remplacer
# PANDECTE_SEAL_KEY_PREVIOUS=   (ancienne clé, le temps d'une rotation)

# -- Identifiants PISTE pour l'usage LOCAL uniquement (MCP_AUTH_MODE=disabled) ------
# Ignorés et retirés au démarrage en mode piste ; refusés en production.
# LEGIFRANCE_CLIENT_ID=identifiant-factice
# LEGIFRANCE_CLIENT_SECRET=secret-factice
# JUDILIBRE_KEY_ID=keyid-factice
LEGIFRANCE_ENV=prod
JUDILIBRE_ENV=prod

# -- Limites (valeurs par défaut) ------------------------------------------------------
# MCP_CALLS_PER_MINUTE_PER_IP=30
# MCP_PERSONAL_KEYS_ENABLED=true

# -- Cache des réponses, en mémoire vive (secondes ; 0 désactive) ------------------------
# PANDECTE_CACHE_TEXT_TTL=21600
# PANDECTE_CACHE_DECISION_TTL=86400
# PANDECTE_CACHE_MAX_MB=50

# -- Adresse IP cliente derrière un proxy ------------------------------------------------
# MCP_TRUSTED_PROXY_HOPS=0
# MCP_CLIENT_IP_HEADER=
# MCP_IP_DIAGNOSTIC=false
