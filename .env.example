# Configuration du serveur MCP PandecteMCP — exemple à valeurs FACTICES.
#
# Pour un essai local : cp .env.example .env, puis remplacer les valeurs.
# Le fichier .env est ignoré par Git. Ne jamais commiter de vraie valeur.
# En production (Render), ces variables se saisissent dans le tableau de bord
# de l'hébergeur ; voir docs/deployment.md.

# -- Mode d'exécution ------------------------------------------------------------
# development | test | production (production impose tous les contrôles).
MCP_ENV=development
MCP_AUTH_MODE=oauth
# URL publique sans /mcp. Hors production, http://localhost:PORT est accepté.
MCP_PUBLIC_URL=http://localhost:8765
MCP_PORT=8765

# -- WorkOS AuthKit --------------------------------------------------------------
MCP_OAUTH_ISSUER=https://exemple-factice.authkit.app
WORKOS_CLIENT_ID=client_01EXEMPLEFACTICE000000000

# -- Jetons personnels -------------------------------------------------------------
# 32 caractères aléatoires minimum en production (ex. : openssl rand -base64 32).
PANDECTE_TOKEN_PEPPER=a-remplacer-par-une-valeur-aleatoire-de-32-caracteres-min
PANDECTE_DATA_DIR=data

# -- Identifiants PISTE du titulaire (mode « serveur partagé ») ----------------------
LEGIFRANCE_CLIENT_ID=identifiant-factice
LEGIFRANCE_CLIENT_SECRET=secret-factice
JUDILIBRE_KEY_ID=keyid-factice
LEGIFRANCE_ENV=prod
JUDILIBRE_ENV=prod

# -- Quotas (valeurs par défaut) ------------------------------------------------------
# MCP_USER_CALLS_PER_MINUTE=10
# MCP_USER_CALLS_PER_DAY=100
# MCP_GLOBAL_CALLS_PER_DAY=2000
# MCP_KEYS_CALLS_PER_MINUTE=30
# MCP_PERSONAL_KEYS_ENABLED=true

# -- Cache des réponses (secondes ; 0 désactive) ---------------------------------------
# PANDECTE_CACHE_TEXT_TTL=21600
# PANDECTE_CACHE_DECISION_TTL=86400
# PANDECTE_CACHE_MAX_MB=200

# -- Adresse IP cliente derrière un proxy ------------------------------------------------
# MCP_TRUSTED_PROXY_HOPS=0
# MCP_CLIENT_IP_HEADER=
# MCP_IP_DIAGNOSTIC=false
